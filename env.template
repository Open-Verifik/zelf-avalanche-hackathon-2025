# ========================================
# LOGGING CONFIGURATION
# ========================================
# Control logging verbosity across the application
LOGGING_ENABLED=true                    # Set to "false" to disable all logging
LOG_LEVEL=info                          # Options: "error", "warn", "info", "debug", "verbose"

# Avalanche-specific logging controls
AVALANCHE_LOGGING=true                  # Set to "false" to disable all Avalanche logging
AVALANCHE_SHOW_SETUP=true               # Show wallet/contract setup logs
AVALANCHE_SHOW_GAS=true                 # Show gas estimation and cost logs
AVALANCHE_SHOW_TX=true                  # Show transaction details
AVALANCHE_SHOW_VERIFY=true              # Show verification and success logs
AVALANCHE_SHOW_IMAGE=true               # Show image rendering info

# ========================================
# STRIPE SUBSCRIPTION CONFIGURATION
# ========================================
# Stripe API Keys (REQUIRED for subscription functionality)
STRIPE_SECRET_KEY=sk_test_...            # Your Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_...       # Your Stripe publishable key (starts with pk_test_ or pk_live_)
STRIPE_WEBHOOK_SECRET=whsec_...          # Your Stripe webhook secret (starts with whsec_)

# Stripe URLs (optional, defaults provided)
STRIPE_REDIRECTURL=https://zelf.world    # Base redirect URL
STRIPE_SUCCESS_URL=https://zelf.world/dashboard/billing?success=true
STRIPE_CANCEL_URL=https://zelf.world/dashboard/billing?canceled=true

# Stripe Price IDs (REQUIRED - Get these from your Stripe Dashboard)
# Create products and prices in Stripe Dashboard, then copy the price IDs here
STRIPE_BASIC_PRICE_ID=price_...          # Basic plan price ID
STRIPE_PRO_PRICE_ID=price_...            # Pro plan price ID  
STRIPE_ENTERPRISE_PRICE_ID=price_...     # Enterprise plan price ID

# ========================================
# STRIPE SETUP INSTRUCTIONS
# ========================================
# 1. Go to https://dashboard.stripe.com/
# 2. Create products for each plan (Basic, Pro, Enterprise)
# 3. Create recurring prices for each product (monthly)
# 4. Copy the price IDs and paste them above
# 5. Set up webhook endpoint: https://your-domain.com/api/subscription/webhook
# 6. Select events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# 7. Copy the webhook secret and paste it above
