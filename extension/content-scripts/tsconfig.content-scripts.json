{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "moduleResolution": "node",
    "outDir": "../dist/dev/ext/chrome",
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "typeRoots": ["../node_modules/@types"],
    "types": ["chrome"]
  },
  "include": [
    "autofill/**/*.ts",
    "autofill/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/**/*",
    "../dist/**/*"
  ]
}